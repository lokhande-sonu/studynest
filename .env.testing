# SQLite in-memory database, array drivers, PayU test mode
# CATEGORY_DISPLAY_ORDER commented out — uses MySQL FIELD() which is unavailable in SQLite
APP_NAME="Study Nest"
APP_ENV=testing
APP_DEBUG=true
APP_URL=http://localhost:8000
APP_KEY=base64:RZ2AYvn6iMCm2w5aeRkxJg28lXZiF6fntyvy2yTLl70=

LOG_CHANNEL=stack
LOG_LEVEL=debug

# Database - SQLite in-memory for tests
DB_CONNECTION=sqlite
DB_DATABASE=:memory:

SESSION_DRIVER=array
CACHE_DRIVER=array
QUEUE_CONNECTION=sync
MAIL_MAILER=array

# File Upload Folders
PRODUCT_CATEGORY_PHOTO="uploads/product-category-photo"
PRODUCT_PHOTO="uploads/product-photo"
CUSTOMER_PROFILE_PHOTO="uploads/customer-profile-photo"
MANAGEMENT_PROFILE_PHOTO="uploads/management-profile-photo"
APP_SLIDER="uploads/app-slider-photo"
SAMPLE_EXCEL="uploads/sample-excel-files"

# CATEGORY_DISPLAY_ORDER disabled for tests — uses MySQL FIELD() which is unavailable in SQLite
# CATEGORY_DISPLAY_ORDER="Books,Uniforms,Accessories,Premium"

# PayU - Test Mode
PAYU_MERCHANT_KEY=test
PAYU_MERCHANT_SALT=test
