APP_NAME="Study Nest"
APP_ENV=local
APP_DEBUG=true
APP_URL=http://localhost:8000
APP_KEY=

LOG_CHANNEL=stack
LOG_LEVEL=debug

# Database
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=studynest_dev
DB_USERNAME=root
DB_PASSWORD=

# Session & Cache
SESSION_DRIVER=file
SESSION_LIFETIME=120
CACHE_DRIVER=file
QUEUE_CONNECTION=sync

# File Upload Folders (relative to public/)
PRODUCT_CATEGORY_PHOTO="uploads/product-category-photo"
PRODUCT_PHOTO="uploads/product-photo"
CUSTOMER_PROFILE_PHOTO="uploads/customer-profile-photo"
MANAGEMENT_PROFILE_PHOTO="uploads/management-profile-photo"
APP_SLIDER="uploads/app-slider-photo"
SAMPLE_EXCEL="uploads/sample-excel-files"

CATEGORY_DISPLAY_ORDER="Books,Uniforms,Accessories,Premium"

# Mail Configuration
MAIL_MAILER=log
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="notification@studynested.com"
MAIL_FROM_NAME="Study Nest"

ADMIN_EMAIL=admin@studynested.com

# WhatsApp Notification API KEY
WHATSAPP_API_KEY=

# SMS Notification
SMS_AUTH_KEY=
SMS_SENDER_ID=
SMS_ENTITY_ID=
SMS_TEMPLATE_ORDER_PLACED=
SMS_TEMPLATE_ORDER_STATUS=
SMS_TEMPLATE_PREBOOKING=

# PayU Payment Gateway
PAYU_MERCHANT_KEY=
PAYU_MERCHANT_SALT=
PAYU_MODE=test

# API Token for Mobile App
APP_API_TOKEN=

# Sanctum Stateful Domains
SANCTUM_STATEFUL_DOMAINS=localhost,localhost:3000,127.0.0.1,127.0.0.1:8000
